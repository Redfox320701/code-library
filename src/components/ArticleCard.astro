---
import type { CollectionEntry } from 'astro:content';

interface Props {
  article: CollectionEntry<'articles'>;
}

const { article } = Astro.props;
const { title, description, topic, level, minutes, pubDate } = article.data;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const url = `${base}articles/${article.id}/`;
const dateLabel = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<a class="article-card" href={url}>
  <span class="article-card__meta">
    <span class="badge badge--topic">{topic}</span>
    <span class={`badge badge--level-${level.toLowerCase()}`}>{level}</span>
  </span>
  <span class="article-card__title">{title}</span>
  <span class="article-card__desc">{description}</span>
  <span class="article-card__foot">
    <time datetime={pubDate.toISOString()}>{dateLabel}</time>
    <span aria-hidden="true">·</span>
    <span>{minutes} min read</span>
  </span>
</a>
